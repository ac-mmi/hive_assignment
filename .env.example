# Required. PostgreSQL connection string used by the Next.js app, migrations, and seed.
# Copy this file to .env.local. Do not commit real credentials.

# Local Docker Compose / Homebrew (user hive / password hive / database hive):
DATABASE_URL=postgres://hive:hive@127.0.0.1:5432/hive

# Production example (Supabase transaction pooler). Replace project, password, and region:
# DATABASE_URL=postgres://postgres.[PROJECT]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
